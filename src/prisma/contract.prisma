// use prisma-8

enum CategoryType {
  INCOME
  EXPENSE
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  type      CategoryType
  active    Boolean @default(true)

  transactions Transaction[]
}

model Transaction {
  id          String    @id @default(uuid()) 
  description String
  value       Numeric(15, 2)
  date        DateTime
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId  Int       
}
